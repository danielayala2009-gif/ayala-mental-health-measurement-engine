"BRS","relationship":"validated_alternative_not_score_equivalent","items":[{"text":"I tend to bounce back quickly after hard times","options":[{"value":1,"label":"Strongly disagree"},{"value":2,"label":"Disagree"},{"value":3,"label":"Neutral"},{"value":4,"label":"Agree"},{"value":5,"label":"Strongly agree"}]},{"text":"I have a hard time making it through stressful events","options":[{"value":1,"label":"Strongly disagree"},{"value":2,"label":"Disagree"},{"value":3,"label":"Neutral"},{"value":4,"label":"Agree"},{"value":5,"label":"Strongly agree"}]},{"text":"It does not take me long to recover from a stressful event","options":[{"value":1,"label":"Strongly disagree"},{"value":2,"label":"Disagree"},{"value":3,"label":"Neutral"},{"value":4,"label":"Agree"},{"value":5,"label":"Strongly agree"}]},{"text":"It is hard for me to snap back when something bad happens","options":[{"value":1,"label":"Strongly disagree"},{"value":2,"label":"Disagree"},{"value":3,"label":"Neutral"},{"value":4,"label":"Agree"},{"value":5,"label":"Strongly agree"}]},{"text":"I usually come through difficult times with little trouble","options":[{"value":1,"label":"Strongly disagree"},{"value":2,"label":"Disagree"},{"value":3,"label":"Neutral"},{"value":4,"label":"Agree"},{"value":5,"label":"Strongly agree"}]},{"text":"I tend to take a long time to get over set-backs in my life","options":[{"value":1,"label":"Strongly disagree"},{"value":2,"label":"Disagree"},{"value":3,"label":"Neutral"},{"value":4,"label":"Agree"},{"value":5,"label":"Strongly agree"}]}]},{"id":"acss","status":"pending","status_label":"VERSION LOCK REQUIRED","items":[]},{"id":"bis11","status":"ready","status_label":"ACTIVE — S-UPPS-P VALIDATED ALTERNATIVE","name":"Short UPPS-P Impulsive Behavior Scale (S-UPPS-P)","participant_measure":"S-UPPS-P","original_measure":"BIS-11","relationship":"validated_alternative_not_score_equivalent","version":"20-item Short UPPS-P","response_model":"20 items; 1–4; five 4-item subscale means","items":[{"text":"I generally like to see things through to the end.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"My thinking is usually careful and purposeful.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"When I am in great mood, I tend to get into situations that could cause me problems.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"Unfinished tasks really bother me.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I like to stop and think things over before I do them.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"When I feel bad, I will often do things I later regret in order to make myself feel better now.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"Once I get going on something I hate to stop.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"Sometimes when I feel bad, I can’t seem to stop what I am doing even though it is making me feel worse.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I quite enjoy taking risks.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I tend to lose control when I am in a great mood.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I finish what I start.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I tend to value and follow a rational, sensible approach to things.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"When I am upset I often act without thinking.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I welcome new and exciting experiences and sensations, even if they are a little frightening and unconventional.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"When I feel rejected, I will often say things that I later regret.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I would like to learn to fly an airplane.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"Others are shocked or worried about the things I do when I am feeling very excited.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I would enjoy the sensation of skiing very fast down a high mountain slope.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I usually think carefully before doing anything.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]},{"text":"I tend to act without thinking when I am really excited.","options":[{"value":1,"label":"Agree strongly"},{"value":2,"label":"Agree some"},{"value":3,"label":"Disagree some"},{"value":4,"label":"Disagree strongly"}]}]},{"id":"exposure","status":"pending","status_label":"SOURCE TRACE PENDING","items":[]},{"id":"imagery","status":"pending","status_label":"SOURCE TRACE PENDING","items":[]}]